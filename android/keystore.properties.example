# Example keystore configuration for signing release APK and AAB
# Rename this file to keystore.properties in the /android directory to use it.
# You can generate a keystore using:
# keytool -genkey -v -keystore release.keystore -alias desi_calculator_key -keyalg RSA -keysize 2048 -validity 10000

storeFile=release.keystore
storePassword=your_store_password_here
keyAlias=desi_calculator_key
keyPassword=your_key_password_here
